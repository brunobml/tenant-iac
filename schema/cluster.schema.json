{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunobml/tenant-iac/schema/cluster.schema.json",
  "title": "Tenant cluster claim (teams/<team>/clusters/<name>-<env>.yaml)",
  "description": "Contract for tenant self-service EKS clusters (2026-10-04 Tenant IaC). Enforces team, name, environment, Kubernetes version, platform network, and instance sizing matching the teamekscluster-contract admission policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["team", "name", "env", "kubernetesVersion", "network", "nodeGroup"],
  "properties": {
    "team": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$",
      "description": "Lowercase DNS label (2-20 characters); must equal the directory teams/<team>/"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$",
      "description": "Cluster name prefix; lowercase DNS label (2-20 characters)"
    },
    "env": {
      "enum": ["dev", "test", "prod"],
      "description": "Environment: dev/test -> spoke-nonprod (account 111111111111), prod -> spoke-prod (222222222222)"
    },
    "kubernetesVersion": {
      "enum": ["1.32", "1.33", "1.34"],
      "description": "Allowed Kubernetes versions"
    },
    "network": {
      "const": "platform-default",
      "description": "Must be platform-default (tier-1 network is owned and managed by the platform)"
    },
    "nodeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceType", "minSize", "desiredSize", "maxSize"],
      "properties": {
        "instanceType": {
          "enum": ["t3.medium", "t3.large", "m5.large"],
          "description": "Allowed EC2 instance types"
        },
        "minSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum node group size (>= 1)"
        },
        "desiredSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Desired node group size"
        },
        "maxSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum node group size"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"env": {"const": "prod"}}
      },
      "then": {
        "properties": {
          "nodeGroup": {
            "properties": {
              "maxSize": {"maximum": 5}
            }
          }
        }
      },
      "else": {
        "properties": {
          "nodeGroup": {
            "properties": {
              "maxSize": {"maximum": 3}
            }
          }
        }
      }
    }
  ]
}
